{
  "name": "voidmob",
  "version": "1.2.1",
  "description": "Receive SMS verification codes for your own accounts on real US non-VoIP numbers, keep a dedicated number, buy eSIM data for travel, and use 4G/5G mobile IPs by country, paid from a prepaid VoidMob balance.",
  "author": {
    "name": "VoidMob",
    "email": "info@voidmob.com",
    "url": "https://voidmob.com"
  },
  "homepage": "https://voidmob.com/mcp",
  "repository": "https://github.com/voidmobcom/voidmob-plugin",
  "license": "MIT",
  "keywords": ["voidmob", "sms-verification", "otp", "non-voip", "esim", "mobile-proxy", "mcp"],
  "skills": "./skills/",
  "mcpServers": {
    "voidmob": {
      "command": "npx",
      "args": ["-y", "@voidmob/mcp@1.2.1"],
      "env": {
        "VOIDMOB_API_KEY": "${VOIDMOB_API_KEY:-}",
        "VOIDMOB_SANDBOX": "${VOIDMOB_SANDBOX:-}",
        "VOIDMOB_READ_ONLY": "${VOIDMOB_READ_ONLY:-}",
        "VOIDMOB_MAX_ORDER_CENTS": "${VOIDMOB_MAX_ORDER_CENTS:-}",
        "VOIDMOB_BUDGET_CENTS": "${VOIDMOB_BUDGET_CENTS:-}"
      }
    }
  }
}
